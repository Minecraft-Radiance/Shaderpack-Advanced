#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : enable

#define ADV_SCENE_RESOURCES_NO_PREVIOUS_GEOMETRY
#include "scene/resources.glsl"
#include "util/vista.glsl"
#include "scene/materials/alpha.glsl"
#include "scene/hit.glsl"
#include "scene/materials/any_hit.glsl"
#include "scene/materials/labpbr.glsl"
#include "util/alpha_mode.glsl"
#include "util/ray_cone.glsl"

#ifndef ADV_CLOUD_MODE
#    define ADV_CLOUD_MODE 1u
#endif
#ifndef ADV_PATH_ANY_HIT_MODE
#    define ADV_PATH_ANY_HIT_MODE 0
#endif

#define ADV_PATH_ANY_HIT_PRIMARY 0
#define ADV_PATH_ANY_HIT_DIFFUSE 1
#define ADV_PATH_ANY_HIT_SPECULAR 2

layout(location = 0) rayPayloadInEXT HitPayload hitPayload;
hitAttributeEXT vec2 pathHitAttributes;

#if ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_PRIMARY
bool isPathAnyHitWaterMaterial(
    uint instanceMask, uint packedData, MaterialVertex m0, vec2 uv, float lod, vec3 p0, vec3 p1, vec3 p2) {
    if ((instanceMask & BOAT_WATER_MASK) != 0u || hasWaterMaterial(m0)) { return true; }
    if (!hasTexture(packedData)) { return false; }
    int flagTexture = mapping.entries[m0.textureID].flag;
    if (flagTexture < 0) { return false; }
    ivec4 flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTexture)], uv, ceil(lod), false) * 255.0));
    if ((flags.r & 0x1) == 0) { return false; }
    vec3 normal = normalize(transpose(mat3(gl_WorldToObject3x4EXT)) * cross(p1 - p0, p2 - p0));
    return abs(normal.y) > 0.75;
}
#endif

#if ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_DIFFUSE
void pathAccumulateDiffuseTransmission() {
    float currentMaximum =
        max(float(hitPayload.transmission.r), max(float(hitPayload.transmission.g), float(hitPayload.transmission.b)));
    if (currentMaximum <= 1e-3) { return; }

    AnyHitMaterial transmissionMaterial = loadAnyHitMaterial(pathHitAttributes, 0.0, 0.0, false, false);
    if (!transmissionMaterial.isCovered || transmissionMaterial.isWater || transmissionMaterial.isCloud) { return; }
    if (!transmissionMaterial.isTransparent) {
        hitPayload.transmission = f16vec3(0.0);
        return;
    }
    hitPayload.transmission *= f16vec3(anyHitTransmission(transmissionMaterial));
    float maximum =
        max(float(hitPayload.transmission.r), max(float(hitPayload.transmission.g), float(hitPayload.transmission.b)));
    if (maximum <= 1e-3) { hitPayload.transmission = f16vec3(0.0); }
}

void pathHandleDiffuseAnyHit() {
    AnyHitMaterial material =
        loadAnyHitMaterial(pathHitAttributes, hitPayload.coneWidth, hitPayload.coneSpread, false, false);
    if (!material.isCovered || material.isTransparent || material.isWater ||
        (material.isCloud && ADV_CLOUD_MODE != 1u)) {
        if (!material.isCloud) { pathAccumulateDiffuseTransmission(); }
        ignoreIntersectionEXT;
    }
}
#endif

#if ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_SPECULAR
void pathHandleSpecularAnyHit() {
    AnyHitMaterial material =
        loadAnyHitMaterial(pathHitAttributes, hitPayload.coneWidth, hitPayload.coneSpread, false, false);
    if (!material.isCovered || (material.isCloud && ADV_CLOUD_MODE != 1u)) { ignoreIntersectionEXT; }
}
#endif

#if ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_PRIMARY
void pathHandlePrimaryAnyHit() {
    uint instanceIndex = gl_InstanceCustomIndexEXT;
    uint instanceMask = loadInstanceMask(instanceIndex);
    if ((instanceMask & CLOUD_MASK) != 0u && ADV_CLOUD_MODE != 1u) {
        ignoreIntersectionEXT;
        return;
    }
    uint geometryBufferIndex = getGeometryBufferIndex(instanceIndex, gl_GeometryIndexEXT);
    uint i0, i1, i2;
    loadTriangleIndices(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2);
    uvec2 info = loadMaterialFlagsAndTexture(geometryBufferIndex, i0);
    MaterialVertex m0;
    m0.packedData = info.x;
    m0.textureID = info.y;
    uint packedData = m0.packedData;
    uint alphaMode = getAlphaMode(packedData);
    if (alphaMode == ALPHA_MODE_OPAQUE && hitPayload.role != ADV_TRACE_ROLE_SECONDARY_OPAQUE) { return; }
    if (hasWaterMaterial(m0)) {
        if (hitPayload.role == ADV_TRACE_ROLE_SECONDARY_OPAQUE) { ignoreIntersectionEXT; }
        return;
    }
    m0 = loadMaterialVertex(geometryBufferIndex, i0);
    PositionVertex p0 = loadPositionVertex(geometryBufferIndex, i0);
    PositionVertex p1 = loadPositionVertex(geometryBufferIndex, i1);
    PositionVertex p2 = loadPositionVertex(geometryBufferIndex, i2);
    MaterialVertex m1 = loadMaterialVertex(geometryBufferIndex, i1);
    MaterialVertex m2 = loadMaterialVertex(geometryBufferIndex, i2);
    bool shouldUseTexture = hasTexture(packedData);
    bool shouldUseColorLayer = hasColorLayer(packedData);
    vec3 bary = vec3(1.0 - pathHitAttributes.x - pathHitAttributes.y, pathHitAttributes.x, pathHitAttributes.y);

    vec2 uv = vec2(0.0);
    float lod = 0.0;
    vec4 albedo = vec4(1.0);
    if (shouldUseTexture) {
        uv = bary.x * m0.textureUV + bary.y * m1.textureUV + bary.z * m2.textureUV;
        vec2 atlasMin = min(m0.textureUV, min(m1.textureUV, m2.textureUV));
        vec2 atlasMax = max(m0.textureUV, max(m1.textureUV, m2.textureUV));
        vec3 dPdu, dPdv;
        computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dPdu, dPdv);
        float coneRadius = hitPayload.coneWidth + gl_HitTEXT * hitPayload.coneSpread;
        lod = lodWithCone(textures[nonuniformEXT(m0.textureID)], uv, max(coneRadius, 0.0), dPdu, dPdv);
        albedo = sampleLabPbrAlbedo(textures[nonuniformEXT(m0.textureID)], uv, atlasMin, atlasMax, lod, alphaMode);
    }

    bool isWater = isPathAnyHitWaterMaterial(instanceMask, packedData, m0, uv, lod, p0.pos, p1.pos, p2.pos);
    if (isWater) {
        if (hitPayload.role == ADV_TRACE_ROLE_SECONDARY_OPAQUE) { ignoreIntersectionEXT; }
        return;
    }

    float colorAlpha =
        shouldUseColorLayer ? bary.x * m0.colorLayer.a + bary.y * m1.colorLayer.a + bary.z * m2.colorLayer.a : 1.0;
    float alpha = clamp(albedo.a * colorAlpha, 0.0, 1.0);
    if (!isAlphaCovered(alpha, alphaMode)) {
        ignoreIntersectionEXT;
        return;
    }
    float opacity = resolveSurfaceOpacity(alpha, alphaMode);
    if (hitPayload.role == ADV_TRACE_ROLE_SECONDARY_OPAQUE && opacity < 1.0 - EPS) { ignoreIntersectionEXT; }
}
#endif

void main() {
    if (isVistaCovered(worldUBO, gl_InstanceCustomIndexEXT, pathHitAttributes)) {
        ignoreIntersectionEXT;
        return;
    }
#if ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_DIFFUSE
    pathHandleDiffuseAnyHit();
#elif ADV_PATH_ANY_HIT_MODE == ADV_PATH_ANY_HIT_SPECULAR
    pathHandleSpecularAnyHit();
#else
    pathHandlePrimaryAnyHit();
#endif
}
