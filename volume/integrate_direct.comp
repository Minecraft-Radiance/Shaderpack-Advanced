#version 460
#extension GL_GOOGLE_include_directive : require

#ifndef ADV_VOLUME_DIRECT_PING_INPUT
#    define ADV_VOLUME_DIRECT_PING_INPUT true
#endif

#include "common/shared.hpp"

layout(set = 2, binding = 0) uniform VolumeWorldUniform {
    WorldUBO worldUBO;
};
layout(set = 2, binding = 1) uniform VolumeLastWorldUniform {
    WorldUBO lastWorldUBO;
};
layout(set = 2, binding = 2) uniform VolumeSkyUniform {
    SkyUBO skyUBO;
};

#include "volume/froxel.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 5, binding = ADV_VOLUME_DIRECT_A_STORAGE_BINDING, rgba16f) readonly uniform image3D volumeDirectAImage;
layout(set = 5, binding = ADV_VOLUME_DIRECT_B_STORAGE_BINDING, rgba16f) readonly uniform image3D volumeDirectBImage;
layout(set = 5,
       binding = ADV_VOLUME_DIRECT_INTEGRAL_STORAGE_BINDING,
       rgba16f) writeonly uniform image3D volumeDirectIntegralImage;
layout(set = 5,
       binding = ADV_VOLUME_TRANSMITTANCE_STORAGE_BINDING,
       rgba16f) writeonly uniform image3D volumeTransmittanceImage;
layout(set = 5, binding = ADV_VOLUME_FAR_HISTORY_A_SAMPLED_BINDING) uniform sampler2D volumeFarHistoryATexture;
layout(set = 5, binding = ADV_VOLUME_FAR_HISTORY_B_SAMPLED_BINDING) uniform sampler2D volumeFarHistoryBTexture;
layout(set = 5,
       binding = ADV_VOLUME_FAR_VISIBILITY_STORAGE_BINDING,
       rgba16f) writeonly uniform image2D volumeFarVisibilityImage;

vec4 loadFarVolumeHistory(ivec2 coordinate) {
    coordinate = clamp(coordinate, ivec2(0), ADV_VOLUME_DIRECT_EXTENT.xy - 1);
    return ADV_VOLUME_DIRECT_PING_INPUT ? texelFetch(volumeFarHistoryBTexture, coordinate, 0) :
                                         texelFetch(volumeFarHistoryATexture, coordinate, 0);
}

void filterFarVolumeVisibility(ivec2 coordinate) {
    vec4 center = loadFarVolumeHistory(coordinate);
    center.a = abs(center.a);
    vec3 visibility = vec3(0.0);
    float totalWeight = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec4 sampleValue = loadFarVolumeHistory(coordinate + ivec2(x, y));
            float spatialWeight = float((2 - abs(x)) * (2 - abs(y)));
            float depthWeight = exp(-abs(abs(sampleValue.a) - center.a) / max(center.a * 0.02, 1.0));
            float weight = spatialWeight * depthWeight;
            visibility += sampleValue.rgb * weight;
            totalWeight += weight;
        }
    }
    imageStore(volumeFarVisibilityImage, coordinate, vec4(visibility / max(totalWeight, 1e-6), center.a));
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coordinate, ADV_VOLUME_DIRECT_EXTENT.xy))) { return; }
    filterFarVolumeVisibility(coordinate);

    bool isUnderwater = isCameraUnderwater(skyUBO.cameraSubmersionType);
    vec2 uv = volumeUvFromFroxel(coordinate, ADV_VOLUME_DIRECT_EXTENT.xy);
    vec3 rayDirection = volumeRayDirection(uv);
    vec3 cameraOrigin = volumeCameraOrigin();
    vec3 extinction = volumeExtinction(isUnderwater);
    vec3 scattering = volumeScattering(isUnderwater);
    vec3 cumulativeInscatter = vec3(0.0);
    vec3 cumulativeTransmittance = vec3(1.0);
    float previousDistance = 0.0;

    for (int slice = 0; slice < ADV_VOLUME_DIRECT_EXTENT.z; ++slice) {
        ivec3 voxel = ivec3(coordinate, slice);
        vec4 volumeSample =
            ADV_VOLUME_DIRECT_PING_INPUT ? imageLoad(volumeDirectBImage, voxel) : imageLoad(volumeDirectAImage, voxel);
        vec3 voxelInscatter = isVolumeFinite(volumeSample.rgb) ? max(volumeSample.rgb, vec3(0.0)) : vec3(0.0);
        float distance = volumeDistanceFromW(volumeSliceCenterW(slice, ADV_VOLUME_DIRECT_EXTENT.z));
        float stepLength = max(distance - previousDistance, 0.0);
        vec3 position = cameraOrigin + rayDirection * distance;
        float density = volumeDensity(position, isUnderwater);
        vec3 stepTransmittance = exp(-extinction * density * stepLength);
        vec3 scatteringAlbedo = scattering / max(extinction, vec3(1e-6));
        vec3 stepInscatter = voxelInscatter * scatteringAlbedo * (vec3(1.0) - stepTransmittance);
        cumulativeInscatter += stepInscatter * cumulativeTransmittance;
        cumulativeTransmittance *= stepTransmittance;
        imageStore(volumeDirectIntegralImage, voxel,
                   vec4(sqrt(clamp(cumulativeInscatter, vec3(0.0), vec3(65504.0))), 1.0));
        imageStore(volumeTransmittanceImage, voxel, vec4(clamp(cumulativeTransmittance, vec3(0.0), vec3(1.0)), 1.0));
        previousDistance = distance;
    }
}
