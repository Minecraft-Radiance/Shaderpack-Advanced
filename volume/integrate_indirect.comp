#version 460
#extension GL_GOOGLE_include_directive : require

#ifndef ADV_VOLUME_INDIRECT_PING_INPUT
#    define ADV_VOLUME_INDIRECT_PING_INPUT true
#endif

#include "common/shared.hpp"

layout(set = 2, binding = 0) uniform VolumeWorldUniform {
    WorldUBO worldUBO;
};
layout(set = 2, binding = 1) uniform VolumeLastWorldUniform {
    WorldUBO lastWorldUBO;
};
layout(set = 2, binding = 2) uniform VolumeSkyUniform {
    SkyUBO skyUBO;
};

#include "volume/froxel.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 5, binding = ADV_VOLUME_INDIRECT_A_STORAGE_BINDING, rgba16f) readonly uniform image3D volumeIndirectAImage;
layout(set = 5, binding = ADV_VOLUME_INDIRECT_B_STORAGE_BINDING, rgba16f) readonly uniform image3D volumeIndirectBImage;
layout(set = 5,
       binding = ADV_VOLUME_INDIRECT_INTEGRAL_STORAGE_BINDING,
       rgba16f) writeonly uniform image3D volumeIndirectIntegralImage;

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(coordinate, ADV_VOLUME_INDIRECT_EXTENT.xy))) { return; }

    bool isUnderwater = isCameraUnderwater(skyUBO.cameraSubmersionType);
    vec2 uv = volumeUvFromFroxel(coordinate, ADV_VOLUME_INDIRECT_EXTENT.xy);
    vec3 rayDirection = volumeRayDirection(uv);
    vec3 cameraOrigin = volumeCameraOrigin();
    vec3 extinction = volumeExtinction(isUnderwater);
    vec3 scattering = volumeScattering(isUnderwater);
    vec3 cumulativeInscatter = vec3(0.0);
    vec3 cumulativeTransmittance = vec3(1.0);
    float previousDistance = 0.0;

    for (int slice = 0; slice < ADV_VOLUME_INDIRECT_EXTENT.z; ++slice) {
        ivec3 voxel = ivec3(coordinate, slice);
        vec4 volumeSample = ADV_VOLUME_INDIRECT_PING_INPUT ? imageLoad(volumeIndirectBImage, voxel) :
                                                             imageLoad(volumeIndirectAImage, voxel);
        vec3 voxelInscatter = isVolumeFinite(volumeSample.rgb) ? max(volumeSample.rgb, vec3(0.0)) : vec3(0.0);
        float distance = volumeDistanceFromW(volumeSliceCenterW(slice, ADV_VOLUME_INDIRECT_EXTENT.z));
        float stepLength = max(distance - previousDistance, 0.0);
        vec3 position = cameraOrigin + rayDirection * distance;
        float density = volumeDensity(position, isUnderwater);
        vec3 stepTransmittance = exp(-extinction * density * stepLength);
        vec3 scatteringAlbedo = scattering / max(extinction, vec3(1e-6));
        vec3 stepInscatter = voxelInscatter * scatteringAlbedo * (vec3(1.0) - stepTransmittance);
        cumulativeInscatter += stepInscatter * cumulativeTransmittance;
        cumulativeTransmittance *= stepTransmittance;
        imageStore(volumeIndirectIntegralImage, voxel,
                   vec4(sqrt(clamp(cumulativeInscatter, vec3(0.0), vec3(65504.0))), 1.0));
        previousDistance = distance;
    }
}
