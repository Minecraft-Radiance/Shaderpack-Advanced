#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "scene/resources.glsl"
#include "core/checkerboard.glsl"
#include "path/state.glsl"
#include "lighting/shadow/payload.glsl"
#include "lighting/bsdf.glsl"
#include "environment/celestial.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT ShadowPayload pathShadowPayload;

layout(set = 5, binding = ADV_BLUE_NOISE_BINDING) uniform sampler2D blueNoiseTexture;
layout(set = 5, binding = ADV_SUN_BRDF_DISTANCE_BINDING, rgba16f) writeonly uniform image2DArray sunBrdfDistanceImage;

#ifndef ADV_RAY_FLAGS
#    define ADV_RAY_FLAGS 0x200u
#endif
#ifndef ADV_PATH_SHADOW_MISS_INDEX
#    define ADV_PATH_SHADOW_MISS_INDEX 0
#endif

#define ADV_SUN_SHADOW_PAYLOAD pathShadowPayload
#define ADV_SUN_SHADOW_PAYLOAD_LOCATION 0
#include "lighting/shadow/trace.glsl"
#include "path/direct.glsl"

void main() {
    ivec2 packedPixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 flatExtent = ivec2(int(ADV_RENDER_WIDTH), int(ADV_RENDER_HEIGHT));
    if (!isPackedCoordinateInBounds(packedPixel, flatExtent)) { return; }
    CheckerCoordinate checker = checkerToFlat(packedPixel, flatExtent);
    if (!checker.isValid) {
        imageStore(sunBrdfDistanceImage, ivec3(packedPixel, ADV_SUN_DIFFUSE_LAYER), vec4(0.0));
        imageStore(sunBrdfDistanceImage, ivec3(packedPixel, ADV_SUN_SPECULAR_LAYER), vec4(0.0));
        return;
    }
    shadeSun(packedPixel, checker, loadShadingPath(packedPixel));
}
