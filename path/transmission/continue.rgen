#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_control_flow_attributes : require

#ifndef USE_SHARC
#    define USE_SHARC 0
#endif
#ifndef SHARC_QUERY
#    define SHARC_QUERY 0
#endif
#if USE_SHARC
#    extension GL_EXT_shader_atomic_int64 : require
#endif

#define ADV_PATH_HIT_DISTANCE_WRITE
#include "scene/resources.glsl"
#include "core/checkerboard.glsl"
#include "path/state.glsl"
#include "lighting/shadow/payload.glsl"
#include "lighting/bsdf.glsl"
#include "environment/parameters.glsl"
#include "lighting/cache/query.glsl"
#include "path/indirect/surface.glsl"
#include "scene/materials/portal.glsl"
#include "path/transmission/state.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT HitPayload hitPayload;
layout(location = 1) rayPayloadEXT ShadowPayload pathShadowPayload;

layout(set = 5, binding = ADV_SKY_RADIANCE_BINDING) uniform samplerCube skyRadianceTexture;
layout(set = 5,
       binding = ADV_TRANSMISSION_RADIANCE_BINDING,
       rgba16f) writeonly uniform image2D transmissionRadianceImage;

#include "environment/sky.glsl"
#include "environment/cloud/shade.glsl"

#ifndef ADV_RAY_FLAGS
#    define ADV_RAY_FLAGS 0x200u
#endif
#ifndef ADV_PATH_SURFACE_MISS_INDEX
#    define ADV_PATH_SURFACE_MISS_INDEX 1
#endif
#ifndef ADV_PATH_SHADOW_MISS_INDEX
#    define ADV_PATH_SHADOW_MISS_INDEX 0
#endif

#define ADV_SUN_SHADOW_PAYLOAD pathShadowPayload
#define ADV_SUN_SHADOW_PAYLOAD_LOCATION 1
#include "lighting/shadow/trace.glsl"

#define ADV_INDIRECT_SURFACE_MISS_INDEX ADV_PATH_SURFACE_MISS_INDEX
#define ADV_INDIRECT_SHADOW_MISS_INDEX ADV_PATH_SHADOW_MISS_INDEX
#define ADV_INDIRECT_HAS_TRANSMISSION_PAYLOAD 0
#include "path/indirect/trace.glsl"

uint refractionIndirectMask() {
    uint mask = WORLD_MASK | CLOUD_MASK | BOAT_WATER_MASK;
    if (worldUBO.isFirstPerson == 0u) { mask |= PLAYER_MASK; }
    return mask;
}

float refractionIndirectDistanceFade(float distanceThroughAir) {
    const float fadeRange = 16.0;
    float fadeEnd = max(float(max(worldUBO.renderDistanceBlocks, worldUBO.vistaDistanceBlocks)), 1.0);
    float fadeStart = max(fadeEnd - fadeRange, 0.0);
    return smoothstep(fadeStart, fadeEnd, max(distanceThroughAir, 0.0));
}

void main() {
    ivec2 packedPixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 flatExtent = ivec2(int(ADV_RENDER_WIDTH), int(ADV_RENDER_HEIGHT));
    if (!isPackedCoordinateInBounds(packedPixel, flatExtent)) { return; }

    TransmissionState terminal = loadTransmissionState(packedPixel);
    if (!terminal.isValid) { return; }

    terminal.hit.coneWidth = terminal.coneWidthAtHit;
    terminal.hit.coneSpread = 0.0;
    HitGeometry terminalGeometry;
    if (!decodeHitGeometry(terminal.hit, vec3(0.0), terminal.rayDirection, terminalGeometry)) { return; }

    uint seed = xxhash32(uvec3(uint(packedPixel.x), uint(packedPixel.y), worldUBO.seed ^ 0xb5297a4du));
    float remainingDistance = max(float(max(worldUBO.renderDistanceBlocks, worldUBO.vistaDistanceBlocks)) - max(terminal.totalDistance, 0.0), 0.0);
    IndirectTraceResult indirect = traceIndirectFromHit(
        terminal.hit, vec3(0.0), terminal.rayDirection, terminal.currentMedium, terminal.coneWidthAtHit,
        terminal.coneSpread, 0.0, true, vec3(1.0), terminal.rayBudgetUsed, ADV_PATH_RAY_BUDGET, false,
        remainingDistance, seed, refractionIndirectMask(), uint(ADV_RAY_FLAGS) | gl_RayFlagsCullBackFacingTrianglesEXT,
        ADV_TRACE_ROLE_PRIMARY, true, true);

    vec3 skyRadiance = shadeIndirectCloud(terminalGeometry.position, terminal.rayDirection,
                                          calculateIndirectSkyRadiance(terminal.rayDirection));
    vec3 terminalRadiance =
        mix(indirect.radiance, skyRadiance, refractionIndirectDistanceFade(terminal.distanceThroughAir));
    vec3 refractionRadiance = sanitizeRadiance(terminalRadiance * terminal.transmission);
    bool isResolved = indirect.isResolved && isFinite(terminal.totalDistance);
    if (isResolved) { imageStore(pathTransmissionDistanceImage, packedPixel, vec4(max(terminal.totalDistance, 1e-4))); }
    imageStore(transmissionRadianceImage, packedPixel, vec4(refractionRadiance, isResolved ? 1.0 : 0.0));
}
