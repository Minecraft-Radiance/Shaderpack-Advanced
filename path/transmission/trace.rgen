#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : enable
#extension GL_EXT_control_flow_attributes : require

#define ADV_PATH_HIT_DISTANCE_WRITE
#include "scene/resources.glsl"
#include "core/checkerboard.glsl"
#include "path/state.glsl"
#include "environment/parameters.glsl"
#define ADV_TRANSMISSION_STATE_WRITE
#include "path/transmission/state.glsl"
#undef ADV_TRANSMISSION_STATE_WRITE

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT HitPayload hitPayload;

layout(set = 5, binding = ADV_SKY_RADIANCE_BINDING) uniform samplerCube skyRadianceTexture;
layout(set = 5,
       binding = ADV_TRANSMISSION_RADIANCE_BINDING,
       rgba16f) writeonly uniform image2D transmissionRadianceImage;

#include "environment/sky.glsl"
#include "environment/cloud/shade.glsl"

#ifndef ADV_RAY_FLAGS
#    define ADV_RAY_FLAGS 0x200u
#endif
#ifndef ADV_PATH_SURFACE_MISS_INDEX
#    define ADV_PATH_SURFACE_MISS_INDEX 1
#endif
#include "path/transmission/shade.glsl"

void main() {
    ivec2 packedPixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 flatExtent = ivec2(int(ADV_RENDER_WIDTH), int(ADV_RENDER_HEIGHT));
    if (!isPackedCoordinateInBounds(packedPixel, flatExtent)) { return; }
    CheckerCoordinate checker = checkerToFlat(packedPixel, flatExtent);
    if (!checker.isValid) {
        clearTransmissionOutput(packedPixel);
        return;
    }
    TransmissionPath primary = loadTransmissionPath(packedPixel);
    shadeTransmission(packedPixel, flatExtent, primary);
}
