#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "output/pixel.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    ivec2 flatPixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 flatExtent = ivec2(int(ADV_RENDER_WIDTH), int(ADV_RENDER_HEIGHT));
    bool inBounds = all(lessThan(flatPixel, flatExtent));
    bool pathValid = false;
    CheckerCoordinate checker;
    ResolvePath primary;
    PixelSignals result = emptyPixelSignals();

    if (inBounds) {
        checker = flatToChecker(flatPixel, flatExtent);
        primary = loadResolvePath(checker.packedPixel);
        pathValid = isPathValid(primary.key);
        if (pathValid) {
            result = resolvePixel(checker, flatExtent, primary);
        } else {
            clearPixelSignals(checker.flatPixel);
        }
    }

#if MCVR_USE_NRD
    uint localIndex = gl_LocalInvocationIndex;
    cloudSpecularTile[localIndex] = result.cloudSpecularCarrier;
    barrier();
#endif

    if (!inBounds || !pathValid) { return; }

#if MCVR_USE_NRD
    if (isCloudSplitPath(primary.key)) {
        vec3 combinedCloudCarrier = result.cloudSpecularCarrier;
        ivec2 pairedFlatPixel = ivec2(checker.flatPixel.x ^ 1, checker.flatPixel.y);
        if (pairedFlatPixel.x < flatExtent.x) {
            CheckerCoordinate pairedChecker = flatToChecker(pairedFlatPixel, flatExtent);
            PathKey pairedKey = loadPathKey(pairedChecker.packedPixel);
            if (isCloudPairCompatible(primary.key, pairedKey)) {
                combinedCloudCarrier =
                    signalSanitizeRadiance((combinedCloudCarrier + cloudSpecularTile[localIndex ^ 1u]) * 0.5);
            }
        }
        result.indirectRaw.specular = vec4(combinedCloudCarrier, 1.0);
        result.specularHitDistance = 1000.0;
        result.specularDirection = signalPackDirectionMoment(vec4(-primary.rayDirection, 1.0));
    }
#endif

    storePixelSignals(checker.flatPixel, result);
}
