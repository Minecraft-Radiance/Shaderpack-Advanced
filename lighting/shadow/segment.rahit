#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define ADV_SCENE_RESOURCES_NO_PREVIOUS_GEOMETRY
#include "scene/resources.glsl"
#include "util/vista.glsl"
#include "lighting/shadow/payload.glsl"
#include "scene/materials/any_hit.glsl"

#ifndef ADV_CLOUD_MODE
#    define ADV_CLOUD_MODE 1u
#endif

layout(location = 1) rayPayloadInEXT ShadowPayload segmentShadowPayload;
hitAttributeEXT vec2 segmentShadowHitAttributes;

void main() {
    if (isVistaCovered(worldUBO, gl_InstanceCustomIndexEXT, segmentShadowHitAttributes)) {
        ignoreIntersectionEXT;
        return;
    }
    if (isShadowPayloadWaterProbe(segmentShadowPayload)) {
        if (isAnyHitWaterProbeSurface(segmentShadowHitAttributes)) {
            segmentShadowPayload.flags |= ADV_SHADOW_FLAG_WATER_SURFACE_FOUND;
            segmentShadowPayload.waterSurfaceHitT = min(segmentShadowPayload.waterSurfaceHitT, gl_HitTEXT);
        } else {
            ignoreIntersectionEXT;
        }
        return;
    }
    bool shouldEvaluateParallax = !shouldShadowPayloadDisableParallax(segmentShadowPayload);
    AnyHitMaterial material = loadAnyHitMaterial(segmentShadowHitAttributes, 0.0, 0.0, shouldEvaluateParallax, true);
    if (!material.isCovered) {
        ignoreIntersectionEXT;
        return;
    }

    bool isTransmissionOnly = isShadowPayloadTransmissionOnly(segmentShadowPayload);
    if (material.isWater) {
        ignoreIntersectionEXT;
        return;
    }

    if (material.isCloud) {
        if (ADV_CLOUD_MODE != 1u) {
            ignoreIntersectionEXT;
            return;
        }
        if (isTransmissionOnly) {
            ignoreIntersectionEXT;
            return;
        }
        segmentShadowPayload.transmission *= vec3(1.0 - 0.666);
        if (max(segmentShadowPayload.transmission.r,
                max(segmentShadowPayload.transmission.g, segmentShadowPayload.transmission.b)) <= 1e-3) {
            segmentShadowPayload.transmission = vec3(0.0);
            terminateRayEXT;
        } else {
            ignoreIntersectionEXT;
        }
        return;
    }

    if (material.isShadowTransparent) {
        if (gl_HitKindEXT == gl_HitKindBackFacingTriangleEXT) {
            ignoreIntersectionEXT;
            return;
        }
        vec3 surfaceTransmission = material.shadowTransmission;
        segmentShadowPayload.transmission *= surfaceTransmission;
        float maximum = max(segmentShadowPayload.transmission.r,
                            max(segmentShadowPayload.transmission.g, segmentShadowPayload.transmission.b));
        if (maximum <= 1e-3) {
            segmentShadowPayload.transmission = vec3(0.0);
            terminateRayEXT;
        } else {
            ignoreIntersectionEXT;
        }
        return;
    }

    if (isTransmissionOnly) {
        ignoreIntersectionEXT;
        return;
    }
    if (shouldEvaluateParallax && !material.doesParallaxOcclude) {
        ignoreIntersectionEXT;
        return;
    }
    if ((material.instanceMask & PLAYER_MASK) != 0u) { segmentShadowPayload.flags |= ADV_SHADOW_FLAG_DYNAMIC_BLOCKER; }
    segmentShadowPayload.blockerHitT = min(segmentShadowPayload.blockerHitT, gl_HitTEXT);
    segmentShadowPayload.transmission = vec3(0.0);
    terminateRayEXT;
}
