#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "scene/resources.glsl"
#include "core/checkerboard.glsl"
#include "lighting/shadow/payload.glsl"
#include "lighting/restir/resampling.glsl"

layout(set = 1, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(location = 0) rayPayloadEXT ShadowPayload restirShadowPayload;

layout(set = 5,
       binding = ADV_RESTIR_DIFFUSE_RADIANCE_BINDING,
       rgba16f) writeonly uniform image2D restirDiffuseRadianceImage;
layout(set = 5,
       binding = ADV_RESTIR_DIFFUSE_DIRECTION_MOMENT_BINDING,
       rgba16f) writeonly uniform image2D restirDiffuseDirectionMomentImage;

#ifndef ADV_RAY_FLAGS
#    define ADV_RAY_FLAGS 0x200u
#endif

void clearRestirOutputs(ivec2 pixel) {
    imageStore(restirDiffuseRadianceImage, pixel, vec4(0.0));
    imageStore(restirDiffuseDirectionMomentImage, pixel, vec4(0.0));
}

void storeRestirHistoryResult(ivec2 pixel, RestirReservoir reservoir) {
    storeTemporalRestirReservoir(pixel, bool(ADV_RESTIR_FRAME_PING_INPUT), reservoir);
}

void rejectRestirHistory(ivec2 pixel) {
    storeRestirHistoryResult(pixel, emptyRestirReservoir());
}

float restirDiffuseModulation(RestirTarget target) {
    return luminance(diffuseAlbedo(target.albedo, target.metallic) * target.opacity * target.throughput);
}

float restirSpatialOutlierScale(ivec2 pixel, ivec2 resolution, RestirTarget target, RestirReservoir reservoir) {
    float modulation = restirDiffuseModulation(target);
    if (modulation <= 1e-6) { return 1.0; }
    float irradiance = reservoir.targetFunction * reservoir.contributionWeight / modulation;
    if (!isBrdfFinite(irradiance) || irradiance <= 1e-6) { return 1.0; }

    const ivec2 offsets[8] = ivec2[8](ivec2(-2, -2), ivec2(0, -2), ivec2(2, -2), ivec2(-2, 0), ivec2(2, 0),
                                      ivec2(-2, 2), ivec2(0, 2), ivec2(2, 2));
    vec2 largest = vec2(0.0);
    uint compatibleCount = 0u;
    uint litCount = 0u;
    float worldPerPixel = restirWorldPerPixel(length(target.position), resolution);
    for (int i = 0; i < 8; ++i) {
        ivec2 neighborPixel = pixel + offsets[i];
        RestirTarget neighbor;
        if (!loadRestirTarget(neighborPixel, resolution, neighbor) || neighbor.isSplit != target.isSplit ||
            neighbor.isSecondary != target.isSecondary || dot(neighbor.geometryNormal, target.geometryNormal) < 0.9 ||
            dot(neighbor.shadingNormal, target.shadingNormal) < 0.9) {
            continue;
        }
        vec3 delta = neighbor.position - target.position;
        float planeDistance = max(abs(dot(delta, target.geometryNormal)), abs(dot(delta, neighbor.geometryNormal)));
        float maxDistance = max(0.25, 3.0 * worldPerPixel * length(vec2(offsets[i])));
        if (planeDistance > 0.05 || dot(delta, delta) > maxDistance * maxDistance) { continue; }
        float neighborModulation = restirDiffuseModulation(neighbor);
        if (neighborModulation <= 1e-6) { continue; }
        ++compatibleCount;

        RestirReservoirHeader header = decodeRestirReservoirHeader(loadSpatialRestirLayer(neighborPixel, 0));
        if (!header.isValid) { continue; }
        uvec4 body = loadSpatialRestirLayer(neighborPixel, 1);
        float neighborIrradiance = uintBitsToFloat(body.y) * uintBitsToFloat(body.z) / neighborModulation;
        if (!isBrdfFinite(neighborIrradiance) || neighborIrradiance <= 1e-6) { continue; }
        ++litCount;
        includeRestirOutlierReference(largest, neighborIrradiance);
        if (largest.y * ADV_RESTIR_OUTLIER_RELATIVE_LIMIT >= irradiance) { return 1.0; }
    }
    return restirOutlierWeightScale(irradiance, largest.y, compatibleCount, litCount);
}

void main() {
    ivec2 pixel = ivec2(gl_LaunchIDEXT.xy);
    ivec2 flatExtent = ivec2(int(ADV_RENDER_WIDTH), int(ADV_RENDER_HEIGHT));
    if (any(greaterThanEqual(pixel, flatExtent))) { return; }
    clearRestirOutputs(pixel);

    RestirTarget target;
    if (!loadRestirTarget(pixel, flatExtent, target)) {
        rejectRestirHistory(pixel);
        return;
    }

    RestirReservoir reservoir = loadSpatialRestirReservoir(pixel);
    if (!reservoir.isValid) {
        rejectRestirHistory(pixel);
        return;
    }

    PackedLight sourceLight;
    if (!loadRestirSourceLight(reservoir.sourceLightIndex, reservoir.sourceChunkIndex, reservoir.sourceId,
                               sourceLight)) {
        rejectRestirHistory(pixel);
        return;
    }
    reservoir.radiance = packedRestirLightRadiance(sourceLight);
    if (!isBrdfFinite(reservoir.radiance)) {
        rejectRestirHistory(pixel);
        return;
    }

    reservoir.targetFunction = evaluateRestirTarget(target, reservoir.radiance, reservoir.point, reservoir.normal);
    if (reservoir.targetFunction <= 1e-8) {
        rejectRestirHistory(pixel);
        return;
    }
    float outlierScale = restirSpatialOutlierScale(pixel, flatExtent, target, reservoir);
    reservoir.contributionWeight *= outlierScale;
    if (outlierScale < 1.0) { reservoir.confidence = min(reservoir.confidence, 1.0); }

    vec3 origin;
    vec3 direction;
    float maximumDistance;
    if (!buildRestirShadowRay(target, reservoir.point, reservoir.normal, origin, direction, maximumDistance)) {
        rejectRestirHistory(pixel);
        return;
    }

    uint shadowFlags = target.isSecondary ? ADV_SHADOW_FLAG_DISABLE_PARALLAX : 0u;
    initShadowPayload(restirShadowPayload, shadowFlags);
    uint mask = WORLD_MASK | PLAYER_MASK | CLOUD_MASK;
    traceRayEXT(topLevelAS, uint(ADV_RAY_FLAGS), mask, 0, 0, 0, origin, 0.0, direction, maximumDistance, 0);
    vec3 transmittance = restirShadowPayload.reachedLight != 0u ?
                             clamp(restirShadowPayload.transmission, vec3(0.0), vec3(1.0)) :
                             vec3(0.0);
    if (!isBrdfFinite(transmittance)) {
        rejectRestirHistory(pixel);
        return;
    }

    storeRestirHistoryResult(pixel, reservoir);
    if (max(transmittance.r, max(transmittance.g, transmittance.b)) <= 1e-8) { return; }

    vec3 diffuseOutput;
    vec3 sampledDirection;
    float targetFunction = evaluateRestirTarget(target, reservoir.radiance, reservoir.point, reservoir.normal,
                                                diffuseOutput, sampledDirection);
    diffuseOutput = sanitizeRadiance(diffuseOutput * transmittance * reservoir.contributionWeight);
    if (!isBrdfFinite(diffuseOutput) || targetFunction <= 1e-8 ||
        max(diffuseOutput.r, max(diffuseOutput.g, diffuseOutput.b)) <= 1e-8) {
        return;
    }

    vec3 guideDirection = target.isSplit ? -target.viewDirection : sampledDirection;
    f16vec3 diffuseOutput16 = f16vec3(diffuseOutput);
    float16_t diffuseLuminance = float16_t(min(luminance(vec3(diffuseOutput16)), ADV_FP16_MAX));
    f16vec3 guideDirection16 = f16vec3(clamp(guideDirection, vec3(-1.0), vec3(1.0)));
    imageStore(restirDiffuseRadianceImage, pixel, vec4(vec3(diffuseOutput16), 1.0));
    imageStore(restirDiffuseDirectionMomentImage, pixel,
               vec4(vec3(guideDirection16 * diffuseLuminance), float(diffuseLuminance)));
}
